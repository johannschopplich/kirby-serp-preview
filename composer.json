{
  "name": "johannschopplich/kirby-serp-preview",
  "description": "See the Google snippet as you type",
  "type": "kirby-plugin",
  "version": "1.5.0",
  "keywords": [
    "kirby",
    "kirby-cms",
    "kirby-plugin",
    "seo",
    "serp",
    "google"
  ],
  "license": "MIT",
  "homepage": "https://kirby.tools/serp-preview",
  "authors": [
    {
      "name": "Johann Schopplich",
      "email": "hello@johannschopplich.com",
      "homepage": "https://johannschopplich.com"
    },
    {
      "name": "Dennis Baum",
      "homepage": "https://github.com/dennisbaum"
    }
  ],
  "require": {
    "php": ">=8.3",
    "getkirby/composer-installer": "^1"
  },
  "require-dev": {
    "getkirby/cms": "^6.0@beta",
    "phpunit/phpunit": "^12",
    "vlucas/phpdotenv": "^5"
  },
  "conflict": {
    "getkirby/cms": "<6"
  },
  "scripts": {
    "dev": [
      "Composer\\Config::disableProcessTimeout",
      "@php -S localhost:8000 -t playground/public vendor/getkirby/cms/router.php"
    ],
    "csfix": "@php tools/phpcs/vendor/bin/php-cs-fixer fix",
    "test": "phpunit",
    "dist": "composer install --no-dev"
  },
  "autoload": {
    "psr-4": {
      "JohannSchopplich\\": "src/classes/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "allow-plugins": {
      "getkirby/composer-installer": true
    }
  },
  "extra": {
    "kirby-cms-path": false,
    "kirby": {
      "compatible": "^6.0"
    }
  }
}
